{
  "id": "elevenlabs",
  "kind": "plugin",
  "version": "1.0.10",
  "label": "ElevenLabs Voices",
  "description": "Give your duckies real ElevenLabs voices. Paste your ElevenLabs API key, then pick a voice per ducky (or as the default) \u2014 premade voices plus any custom/cloned voices from your account.",
  "min_app_version": "1.0.0",
  "default_enabled": false,
  "secret_keys": [
    "elevenlabs_api_key"
  ],
  "contributes": {
    "settings.tabs": [
      {
        "id": "ElevenLabs",
        "label": "ElevenLabs",
        "icon": "assets/icon.svg"
      }
    ],
    "settings.sections": [
      {
        "tab": "ElevenLabs",
        "id": "account",
        "title": "ElevenLabs account",
        "description": "Paste your ElevenLabs API key (from elevenlabs.io \u2192 Profile \u2192 API Keys). It is stored encrypted on this device and never leaves it except to call ElevenLabs. Once set, your account's voices appear in every voice picker.",
        "order": 10,
        "properties": [
          {
            "id": "elevenlabs_api_key",
            "type": "secret",
            "label": "API key",
            "placeholder": "sk_\u2026",
            "description": "Your ElevenLabs API key. Required for voices to work."
          },
          {
            "id": "model_id",
            "type": "select",
            "label": "Voice model",
            "default": "eleven_multilingual_v2",
            "description": "Quality vs. speed/cost. Multilingual v2 is the most natural; Turbo/Flash are faster and cheaper for live back-and-forth.",
            "options": [
              {
                "value": "eleven_multilingual_v2",
                "label": "Multilingual v2 \u2014 best quality"
              },
              {
                "value": "eleven_turbo_v2_5",
                "label": "Turbo v2.5 \u2014 fast, ~half cost"
              },
              {
                "value": "eleven_flash_v2_5",
                "label": "Flash v2.5 \u2014 fastest, cheapest"
              }
            ]
          }
        ]
      }
    ],
